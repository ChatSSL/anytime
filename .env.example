# 이 파일을 .env로 복사해서 값을 채운다. .env는 저장소에 올리지 않는다.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=anytime
DB_USER=anytime
DB_PASSWORD=anytime

# 이메일 저장용 비밀키 (팀이 같은 값을 써야 시드·로그인이 맞는다. 팀방에서만 공유)
EMAIL_HASH_KEY=
EMAIL_ENC_KEY=

# 5단계 이메일 인증: Gmail 앱 비밀번호
MAIL_USERNAME=
MAIL_APP_PASSWORD=

# 7단계 JWT
JWT_SECRET=

# A단계 AI 연동
AI_API_KEY=
