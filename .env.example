# 이 파일을 .env로 복사해서 값을 채운다. .env는 저장소에 올리지 않는다.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=anytime
DB_USER=anytime
DB_PASSWORD=anytime

# 실행할 때마다 DB를 시드로 초기화할지 (always: 초기화, never: 데이터 유지)
# 로컬 기본값은 always, 서버 기본값은 never
SQL_INIT_MODE=always

# 이메일 저장용 비밀키 (5단계 이메일 인증에서 사용)
# 같은 DB를 쓰는 서버끼리는 같은 값이어야 가입한 사용자가 다시 로그인할 수 있다. 값은 팀방에서만 공유
# 시드 사용자는 이메일 로그인을 하지 않아서 이 키와 상관없다
EMAIL_HASH_KEY=
EMAIL_ENC_KEY=

# 5단계 이메일 인증: Gmail 앱 비밀번호
MAIL_USERNAME=
MAIL_APP_PASSWORD=

# 7단계 JWT
JWT_SECRET=

# A단계 AI 연동
AI_API_KEY=
